-- PathV2 grounded edition. No hover forces, vertical tweening, or above-safe finish.
-- TweenV2 smooths WalkSpeed only; Humanoid:Move handles grounded waypoint movement.
local PathfindingService = game:GetService("PathfindingService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")
local PathV2 = { Version = "2.0.0-grounded" }
local active = setmetatable({}, { __mode = "k" })

local function flat(v) return Vector3.new(v.X, 0, v.Z) end
local function finite(v) return type(v) == "number" and v == v and math.abs(v) < math.huge end

function PathV2.RootHeight(character)
	local root = assert(character:FindFirstChild("HumanoidRootPart"), "Missing HumanoidRootPart")
	local humanoid = assert(character:FindFirstChildOfClass("Humanoid"), "Missing Humanoid")
	local height = humanoid.HipHeight + root.Size.Y / 2
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		height = height + (leg and leg.Size.Y or 2)
	end
	return height
end

function PathV2.Go(TweenV2, character, goal, options)
	assert(type(TweenV2) == "function", "PathV2 requires your loaded TweenV2 function")
	assert(RunService:IsClient(), "This PathV2 controller runs on the client")
	assert(typeof(goal) == "Vector3" and finite(goal.Magnitude), "Goal must be a finite Vector3")
	local root = assert(character:FindFirstChild("HumanoidRootPart"), "Missing HumanoidRootPart")
	local humanoid = assert(character:FindFirstChildOfClass("Humanoid"), "Missing Humanoid")
	local defaults = {
		WalkSpeed = 6, SpeedRampTime = 0.25,
		AgentRadius = 2, AgentHeight = 6, WaypointSpacing = 4,
		WaypointTolerance = 0.75, FinalTolerance = 1,
		HeightTolerance = 2, CheckInterval = 0.1, LookAhead = 2,
		StuckTime = 6, MinProgress = 0.1,
		RepathDelay = 1, MaxReplans = 0,
		ApproachMargin = 1, ProbeHeight = 1, ProbeDepth = 256,
	}
	local optional = { GoalPart = true, Owner = true, Costs = true }
	local o = table.clone(defaults)
	for key, value in pairs(options or {}) do
		assert(defaults[key] ~= nil or optional[key], "Unknown grounded PathV2 option: " .. tostring(key))
		o[key] = value
	end
	for key in pairs(defaults) do assert(finite(o[key]) and o[key] >= 0, "Invalid " .. key) end
	assert(o.WalkSpeed > 0 and o.AgentRadius >= 1 and o.AgentHeight >= 2, "Invalid speed/body size")
	assert(o.WaypointSpacing > 0 and o.WaypointTolerance > 0 and o.FinalTolerance > 0, "Invalid waypoint settings")
	assert(o.CheckInterval > 0 and o.StuckTime > 0 and o.MinProgress > 0 and o.RepathDelay >= 0.1, "Invalid timing")
	assert(o.MaxReplans % 1 == 0 and o.ProbeDepth > o.ProbeHeight, "Invalid retries/probe depth")
	assert(o.GoalPart == nil or (typeof(o.GoalPart) == "Instance" and o.GoalPart:IsA("BasePart")), "GoalPart must be a BasePart")
	assert(o.Owner == nil or typeof(o.Owner) == "Instance", "Owner must be an Instance")
	local footHeight = PathV2.RootHeight(character)
	local casts = RaycastParams.new()
	casts.FilterType = Enum.RaycastFilterType.Exclude
	casts.FilterDescendantsInstances = { character }
	casts.RespectCanCollide = true
	casts.CollisionGroup = root.CollisionGroup
	local overlaps = OverlapParams.new()
	overlaps.FilterType = Enum.RaycastFilterType.Exclude
	overlaps.FilterDescendantsInstances = { character }
	overlaps.RespectCanCollide = true
	overlaps.CollisionGroup = root.CollisionGroup
	overlaps.MaxParts = 1
	local events, path, pendingPath, blockedConnection, speedTween = {}, nil, nil, nil, nil
	local done = Instance.new("BindableEvent")
	local route = { Status = "Idle", Completed = done.Event, Replans = 0, WaypointIndex = 0 }
	local direction, replan, revision = Vector3.zero, false, 0
	local oldSpeed, oldRotate, oldJumpEnabled, owned = nil, nil, nil, false
	local binding = "PathV2Grounded_" .. HttpService:GenerateGUID(false)
	local bound = false

	local function clearPath()
		if blockedConnection then blockedConnection:Disconnect(); blockedConnection = nil end
		if path then path:Destroy(); path = nil end
		if pendingPath then pendingPath:Destroy(); pendingPath = nil end
	end
	local function finish(status, detail)
		if route.Result then return end
		route.Status, route.Result, route.Detail = status, status, detail
		direction = Vector3.zero
		if bound then RunService:UnbindFromRenderStep(binding); bound = false end
		clearPath()
		if speedTween then speedTween:Cancel("RouteFinished"); speedTween = nil end
		for _, connection in ipairs(events) do connection:Disconnect() end
		table.clear(events)
		if active[character] == route then active[character] = nil end
		if owned then
			pcall(function()
				humanoid:Move(Vector3.zero, false)
				humanoid.WalkSpeed = oldSpeed
				humanoid.AutoRotate = oldRotate
				humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, oldJumpEnabled)
			end)
		end
		done:Fire(status, detail)
		task.defer(function() done:Destroy() end)
	end
	function route:Cancel(reason) finish("Cancelled", reason or "User") end
	function route:Destroy() self:Cancel("Destroyed") end
	function route:Await()
		if self.Result then return self.Result, self.Detail end
		return self.Completed:Wait()
	end
	function route:Repath(reason)
		if self.Result then return end
		replan, revision, direction = true, revision + 1, Vector3.zero
		self.Detail = reason or "Requested"
	end
	local function alive()
		if route.Result then return false end
		if not root.Parent or not humanoid.Parent or not character.Parent or humanoid.Health <= 0 then finish("Cancelled", "CharacterUnavailable"); return false end
		if root.Anchored then finish("Failed", "RootAnchored"); return false end
		if o.GoalPart and not o.GoalPart:IsDescendantOf(Workspace) then finish("Cancelled", "GoalRemoved"); return false end
		return true
	end
	local function waitGround()
		direction = Vector3.zero
		while alive() and humanoid.FloorMaterial == Enum.Material.Air do
			route.Status = "WaitingForGround"
			RunService.Heartbeat:Wait()
		end
		return alive()
	end
	local function approachPoints()
		local points = {}
		local function add(sample)
			local hit = Workspace:Raycast(sample + Vector3.new(0, o.ProbeHeight, 0), Vector3.new(0, -o.ProbeDepth, 0), casts)
			if not hit or hit.Normal.Y < 0.5 then return end
			local boxCenter = hit.Position + Vector3.new(0, o.AgentHeight / 2 + 0.1, 0)
			local size = Vector3.new(o.AgentRadius * 2 - 0.2, o.AgentHeight - 0.2, o.AgentRadius * 2 - 0.2)
			if #Workspace:GetPartBoundsInBox(CFrame.new(boxCenter), size, overlaps) == 0 then
				table.insert(points, hit.Position)
			end
		end
		if o.GoalPart then
			local part = o.GoalPart
			local extent = part.Size / 2 + Vector3.new(o.AgentRadius + o.ApproachMargin, 0, o.AgentRadius + o.ApproachMargin)
			for _, d in ipairs({ Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1), Vector3.new(1, 0, 1), Vector3.new(-1, 0, 1), Vector3.new(1, 0, -1), Vector3.new(-1, 0, -1) }) do
				local p = part.CFrame:PointToWorldSpace(Vector3.new(d.X * extent.X, 0, d.Z * extent.Z))
				-- Ground probes use the object's level, never a repeated root-height lift.
				add(Vector3.new(p.X, part.Position.Y, p.Z))
			end
		else
			add(goal)
		end
		table.sort(points, function(a, b) return (a - root.Position).Magnitude < (b - root.Position).Magnitude end)
		return points
	end
	local function plan(expectedRevision)
		local reason = "NoClearGroundBesideGoal"
		for _, destination in ipairs(approachPoints()) do
			if not alive() or revision ~= expectedRevision then return nil, nil, "Interrupted" end
			local candidate = PathfindingService:CreatePath({
				AgentRadius = math.ceil(o.AgentRadius), AgentHeight = math.ceil(o.AgentHeight),
				AgentCanJump = false, AgentCanClimb = false,
				WaypointSpacing = o.WaypointSpacing, Costs = o.Costs or {},
			})
			pendingPath = candidate
			local ok, err = pcall(function() candidate:ComputeAsync(root.Position, destination) end)
			if not alive() or revision ~= expectedRevision then candidate:Destroy(); pendingPath = nil; return nil, nil, "Interrupted" end
			if ok and candidate.Status == Enum.PathStatus.Success then
				local waypoints = candidate:GetWaypoints()
				local usable = #waypoints > 0
				for _, waypoint in ipairs(waypoints) do
					if waypoint.Action ~= Enum.PathWaypointAction.Walk then usable = false; break end
				end
				if usable then pendingPath = nil; return candidate, waypoints end
				reason = "RouteRequiresUnsupportedTraversal"
			else
				reason = ok and "NoPath" or tostring(err)
			end
			candidate:Destroy()
			pendingPath = nil
		end
		return nil, nil, reason
	end
	local function walkTo(point, tolerance)
		local best, lastProgress, lastCheck = math.huge, os.clock(), 0
		while alive() and not replan do
			local delta = flat(point - root.Position)
			local distance = delta.Magnitude
			local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
			local feetY = root.Position.Y - footHeight
			if grounded and distance <= tolerance and math.abs(feetY - point.Y) <= o.HeightTolerance then direction = Vector3.zero; return true end
			if not grounded then
				direction = Vector3.zero
				route:Repath("GroundLost")
				return false
			end
			local now = os.clock()
			if best - distance >= o.MinProgress then best, lastProgress = distance, now end
			if now - lastProgress >= o.StuckTime then route:Repath("NoProgress"); return false end
			direction = distance > 0.001 and delta.Unit or Vector3.zero
			if now - lastCheck >= o.CheckInterval and distance > tolerance then
				lastCheck = now
				-- Check ahead at torso height. Steps remain handled by the Humanoid.
				local size = Vector3.new(o.AgentRadius * 2 - 0.2, math.max(root.Size.Y, 1), o.AgentRadius * 2 - 0.2)
				local hit = Workspace:Blockcast(CFrame.new(root.Position), size, direction * math.min(o.LookAhead, distance), casts)
				if hit then route:Repath("ObstacleAhead"); return false end
			end
			RunService.Heartbeat:Wait()
		end
		direction = Vector3.zero
		return false
	end

	if active[character] then active[character]:Cancel("Replaced") end
	active[character] = route
	table.insert(events, humanoid.Died:Connect(function() finish("Cancelled", "Died") end))
	table.insert(events, humanoid.Destroying:Connect(function() finish("Cancelled", "HumanoidDestroyed") end))
	table.insert(events, root.Destroying:Connect(function() finish("Cancelled", "RootDestroyed") end))
	table.insert(events, character.Destroying:Connect(function() finish("Cancelled", "CharacterDestroyed") end))
	if o.GoalPart then table.insert(events, o.GoalPart.Destroying:Connect(function() finish("Cancelled", "GoalDestroyed") end)) end
	if o.Owner then table.insert(events, o.Owner.Destroying:Connect(function() finish("Cancelled", "OwnerDestroyed") end)) end
	task.spawn(function()
		local ok, err = pcall(function()
			if not alive() then return end
			assert(not root:FindFirstChild("TweenV2Force"), "Stop the old hovering script and reset your character before using grounded PathV2")
			oldSpeed, oldRotate = humanoid.WalkSpeed, humanoid.AutoRotate
			oldJumpEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping)
			owned = true
			humanoid.AutoRotate = true
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
			if humanoid:GetState() == Enum.HumanoidStateType.Physics then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
			-- Only a numeric property is tweened. Never root Position/CFrame.
			speedTween = TweenV2(humanoid, { WalkSpeed = o.WalkSpeed }, {
				Mode = "Eased", Duration = o.SpeedRampTime, Ease = "Smooth", Timeout = 0,
			})
			RunService:BindToRenderStep(binding, Enum.RenderPriority.Character.Value + 1, function()
				if not route.Result and humanoid.Parent then
					humanoid:Move(humanoid.FloorMaterial ~= Enum.Material.Air and direction or Vector3.zero, false)
				end
			end)
			bound = true
			while alive() do
				replan, direction = false, Vector3.zero
				clearPath()
				if not waitGround() then return end
				route.Status = "Planning"
				local expectedRevision = revision
				local candidate, waypoints, why = plan(expectedRevision)
				if not alive() then if candidate then candidate:Destroy() end; return end
				if candidate and revision == expectedRevision then
					path = candidate
					blockedConnection = path.Blocked:Connect(function(index)
						if index >= route.WaypointIndex then route:Repath("PathBlocked") end
					end)
					route.Status = "Walking"
					local completed = true
					for index, waypoint in ipairs(waypoints) do
						route.WaypointIndex = index
						if not walkTo(waypoint.Position, index == #waypoints and o.FinalTolerance or o.WaypointTolerance) then completed = false; break end
					end
					if completed and alive() then finish("Completed"); return end
				elseif candidate then candidate:Destroy() end
				if not alive() then return end
				clearPath()
				route.Replans = route.Replans + 1
				route.Status = "WaitingForPath"
				route.Detail = why or route.Detail or "Replanning"
				if o.MaxReplans > 0 and route.Replans > o.MaxReplans then finish("NoPath", route.Detail); return end
				local untilTime = os.clock() + o.RepathDelay
				while alive() and os.clock() < untilTime do RunService.Heartbeat:Wait() end
			end
		end)
		if not ok then finish("Failed", tostring(err)); warn("PathV2: " .. tostring(err)) end
	end)
	return route
end

return PathV2
